# Machine-local settings -- copy to `env.local.sh` and edit. NEVER commit the real file:
# `env.local.sh` is gitignored, this `.example` is tracked and must hold placeholders only.
#
# Sourced by scripts/run_fold_subset_cv.sh after its defaults, so these values win.
# One per machine: the repo stays identical everywhere, only this file differs.

# Absolute path to the python interpreter of the pinned env (see requirements.lock.txt).
#   home box (MeowstickPC): /home/miles/miniconda3/envs/WSTS_original/bin/python
#   miles-workspace:        /home/miles_goodman/miniconda3/envs/WSTS_original/bin/python
PY=/path/to/miniconda3/envs/WSTS_original/bin/python

# Absolute path to the hdf5 dataset root (the dir containing 2018/ 2019/ 2020/ 2021/).
# cfgs/data_base.yaml hardcodes the original author's path; this overrides it on the CLI.
DATA_DIR=/path/to/FE_WSTS/hdf5_data

# wandb credentials. Project and entity are committed in cfgs/trainer_single_gpu.yaml;
# only the key is machine-local. Without it wandb silently drops to OFFLINE mode and the
# run never reaches the server -- the cause of the stray offline-run-* dirs from 2026-09.
# Get it from https://wandb.ai/authorize . Never `wandb login` interactively.
export WANDB_API_KEY=

# Optional: distinguishes this machine's runs when several boxes write to one project.
# Runs are named <ARM>_seed<N>_fold<K>, so two machines running the same arm collide.
export WANDB_TAGS_HOST=host_$(hostname | tr -c 'a-zA-Z0-9' '_')
